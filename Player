package Projekat;

class Player extends GameObject {
	private String name;
	private int health;

	public Player(int x, int y, int width, int height, String name, int health) {
		super(x, y, width, height);
		this.name = name;
		this.health = health;
	}

	public String getName() {
		return name;
	}
	
	public void setName(String name) {
		if(name == null) {
			System.out.println("Ime ne smije biti prazno.");
		}
		
		String clean = name.trim().replaceAll("\\s+", " ");
		
		if(clean == " ")
			System.out.println("Ime ne smije biti prazno.");
		
		StringBuilder sb = new StringBuilder();
		boolean velikoSlovo = true;
		
		for(int i = 0; i < clean.length(); i++) {
			char c = clean.charAt(i);
			
			if(c == ' ') {
				sb.append(c);
				velikoSlovo = true;
			} else {
				if(velikoSlovo)
					sb.append(Character.toUpperCase(c));
				velikoSlovo = false;
			} 
	}
		this.name = sb.toString();
		
		this.name = name;
	}

	public int getHealth() {
		return health;
	}

	public void setHealth(int health) {
		if(health >= 0 || health <= 100)
		this.health = health;
	}
/* Player[Player1] @ (10,5) 32x32 HP=85 */

	@Override
	public String toString() {
		return "Player[" + name + "] @ (" + getX() + ", " + getY() + ") " + getWidth() + "x" + getHeight()
				+ " HP=" + health;
	}
	}
	
