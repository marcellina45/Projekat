package Projekat;

public class BossEnemy extends Enemy {
	public BossEnemy(int x, int y, int width, int height, String type, int damage) {
		super(x, y, width, height, type, damage);
	}

	public double doubleDamage() {
		double damageDouble = getDamage() *2;
		return damageDouble;
	}
		
	@Override
	public String toString() {
		return "BossEnemy[" + getType() + "] @ (" + getX() + ", " + getY() + ") " + getWidth() + "x" + getHeight() + " DMG="
				+ getDamage();
	}
}
